# Login (required in production)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Cookie signing secret: openssl rand -hex 32
AUTH_SECRET=
# Vercel Blob token (optional, shared cloud storage)
BLOB_READ_WRITE_TOKEN=
# Master password for protected actions (score edits, reset, finish, History delete). Server-only.
# This is only the BOOTSTRAP value: once it is changed from the secret page, a salted hash is stored
# (master.json in Blob/data folder) and this value is ignored. Forgot it? Delete master.json to fall back here.
# Unset with no stored password in production = protected actions are refused.
MASTER_PASSWORD=
# Secret URL segment to change the master password at /master/<value>. Any length works, but a long random
# value (e.g. openssl rand -hex 24) is much harder to guess.
# Unset = the page and API are disabled (404). The page also requires the site login and the CURRENT password.
MASTER_ADMIN_PATH=
