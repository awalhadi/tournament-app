# Login (required in production)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Cookie signing secret: openssl rand -hex 32
AUTH_SECRET=
# Vercel Blob token (optional, shared cloud storage)
BLOB_READ_WRITE_TOKEN=
# Required to change a score that is already saved. Server-only. Unset in production = score edits refused.
MASTER_PASSWORD=
