# Example environment for ITclan TT Arena. Replace the values before using in production.
# Never commit this file. Set the same variables in your hosting dashboard for deploys.

# Login credentials (required in production, otherwise every request returns 503)
BASIC_AUTH_USER=admin@app.com
BASIC_AUTH_PASSWORD=1234

# Secret used to sign the session cookie (optional but recommended).
# Generate one with: openssl rand -hex 32
AUTH_SECRET=itclan

# Vercel Blob token (optional). Enables shared cloud storage across devices.
# Without it the app saves to data/tournament.json and the browser's localStorage.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
BLOB_STORE_ID="store_NkWhWMyGYf0pUesA"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_NkWhWMyGYf0pUesA_tONuFOsusLFjgYtFH3oXuFD1EoKad1"

# Master password required to change a score that is already saved (server-side only, never NEXT_PUBLIC_)
MASTER_PASSWORD=51234
